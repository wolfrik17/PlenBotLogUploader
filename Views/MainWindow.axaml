<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PlenBotLogUploader.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:services="using:PlenBotLogUploader.Services"
        xmlns:discord="using:PlenBotLogUploader.DiscordApi"
        xmlns:teams="using:PlenBotLogUploader.Teams"
        xmlns:pings="using:PlenBotLogUploader.RemotePing"
        xmlns:arcdps="using:PlenBotLogUploader.ArcDps"
        xmlns:aleeva="using:PlenBotLogUploader.Aleeva"
        xmlns:gw2api="using:PlenBotLogUploader.AppSettings"
        xmlns:twitch="using:PlenBotLogUploader.Twitch"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="750"
        x:Class="PlenBotLogUploader.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Resources/Icon.ico"
        Title="PlenBot Log Uploader"
        Width="1100" Height="750"
        MinWidth="850" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True">

    <Grid RowDefinitions="Auto,*">
        <!-- Top App Bar -->
        <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" 
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Brand Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Image Source="/Resources/Icon.ico" Width="28" Height="28" VerticalAlignment="Center" />
                    <TextBlock Text="PlenBot Log Uploader" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Background="#2196F3" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="Cross-Platform" FontSize="11" Foreground="White" FontWeight="Bold" />
                    </Border>
                </StackPanel>

                <!-- Status Badges -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Monitoring Badge -->
                    <Border CornerRadius="12" Padding="10,4" Background="{DynamicResource SystemAccentColor}">
                        <TextBlock Text="{Binding MonitoringStatusText}" 
                                   Foreground="White" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                    <!-- Session Badge -->
                    <Border IsVisible="{Binding IsSessionRunning}" CornerRadius="12" Padding="10,4" Background="#E65100">
                        <TextBlock Text="{Binding SessionStatusText}" 
                                   Foreground="White" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                    <!-- Twitch Badge -->
                    <Border IsVisible="{Binding IsTwitchConnected}" CornerRadius="12" Padding="10,4" Background="#9146FF">
                        <TextBlock Text="Twitch Connected" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <!-- Quick Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Command="{Binding ToggleMonitoringCommand}">
                        <TextBlock Text="{Binding MonitoringButtonText}" />
                    </Button>
                    <Button Command="{Binding ToggleSessionCommand}">
                        <TextBlock Text="{Binding SessionButtonText}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body: Navigation Sidebar + Content Area -->
        <Grid Grid.Row="1" ColumnDefinitions="220,*">
            <!-- Sidebar Navigation -->
            <Border Grid.Column="0" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,1,0"
                    Padding="8,12">
                <ListBox SelectedIndex="{Binding SelectedNavigationIndex}" SelectionMode="Single">
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="4,6">
                            <TextBlock Text="📊" FontSize="16" />
                            <TextBlock Text="Dashboard" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="4,6">
                            <TextBlock Text="🌐" FontSize="16" />
                            <TextBlock Text="Integrations" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="4,6">
                            <TextBlock Text="⏱️" FontSize="16" />
                            <TextBlock Text="Log Session" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="4,6">
                            <TextBlock Text="🧩" FontSize="16" />
                            <TextBlock Text="arcDPS Plugins" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="4,6">
                            <TextBlock Text="👥" FontSize="16" />
                            <TextBlock Text="Teams &amp; GW2" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="4,6">
                            <TextBlock Text="⚙️" FontSize="16" />
                            <TextBlock Text="Settings" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Border>

            <!-- Content Area (Switching by SelectedNavigationIndex) -->
            <Carousel Grid.Column="1" SelectedIndex="{Binding SelectedNavigationIndex}">
                <!-- 0: DASHBOARD VIEW -->
                <Grid RowDefinitions="Auto,Auto,*,220" Margin="16">
                    <!-- Logs Folder Path Banner -->
                    <Border Grid.Row="0" Margin="0,0,0,12" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="14,10">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <TextBlock Grid.Column="0" Text="arcDPS Logs Folder:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox Grid.Column="1" Text="{Binding LogsLocation}" IsReadOnly="True" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseLogsFolderCommand}" Margin="0,0,6,0" />
                            <Button Grid.Column="3" Content="Open Folder" Command="{Binding OpenLogsFolderCommand}" />
                        </Grid>
                    </Border>

                    <!-- Stat Cards & Drag & Drop Zone -->
                    <Grid Grid.Row="1" Margin="0,0,0,12" ColumnDefinitions="*,*,*,2*">
                        <!-- Stat: Total Logs -->
                        <Border Grid.Column="0" Margin="0,0,6,0" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="12,10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Total Logs Scanned" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                <TextBlock Text="{Binding LogsCount}" FontSize="24" FontWeight="Bold" Foreground="#2196F3" />
                            </StackPanel>
                        </Border>

                        <!-- Stat: Uploaded Logs -->
                        <Border Grid.Column="1" Margin="6,0,6,0" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="12,10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Session Uploads" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                <TextBlock Text="{Binding RecentUploads.Count}" FontSize="24" FontWeight="Bold" Foreground="#4CAF50" />
                            </StackPanel>
                        </Border>

                        <!-- Stat: Max Concurrency -->
                        <Border Grid.Column="2" Margin="6,0,6,0" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="12,10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Concurrent Limit" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                <TextBlock Text="{Binding MaxConcurrentUploads}" FontSize="24" FontWeight="Bold" Foreground="#FF9800" />
                            </StackPanel>
                        </Border>

                        <!-- Drag and Drop Dropzone Card -->
                        <Border Grid.Column="3" Margin="6,0,0,0" BorderBrush="{DynamicResource SystemAccentColor}" BorderThickness="2"
                                CornerRadius="8" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                Padding="10">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="📥 Drag &amp; Drop .evtc / .zevtc Files Here" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" />
                                <TextBlock Text="Instant upload to dps.report" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Recent Uploads DataGrid -->
                    <Border Grid.Row="2" Margin="0,0,0,12" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="8">
                        <Grid RowDefinitions="Auto,*">
                            <TextBlock Grid.Row="0" Text="Recent Uploads" FontSize="14" FontWeight="SemiBold" Margin="4,0,0,8" />
                            <DataGrid Grid.Row="1" ItemsSource="{Binding RecentUploads}" AutoGenerateColumns="False" IsReadOnly="True"
                                      GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding TimestampString}" Width="80" />
                                    <DataGridTextColumn Header="Boss Encounter" Binding="{Binding BossName}" Width="*" />
                                    <DataGridTextColumn Header="Mode" Binding="{Binding ModeBadge}" Width="70" />
                                    <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="80" />
                                    <DataGridTemplateColumn Header="Result" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="services:LogUploadItem">
                                                <Border Background="#2E7D32" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ResultBadge}" Foreground="White" FontSize="11" FontWeight="Bold" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Link" Width="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="services:LogUploadItem">
                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <Button Content="Open" Click="OnOpenLogLinkClick" Tag="{Binding Permalink}" Padding="6,2" FontSize="11" />
                                                    <Button Content="Copy" Click="OnCopyLogLinkClick" Tag="{Binding Permalink}" Padding="6,2" FontSize="11" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Live Activity Log Console -->
                    <Border Grid.Row="3" Background="#1E1E1E" CornerRadius="8" Padding="10">
                        <Grid RowDefinitions="Auto,*">
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,6">
                                <TextBlock Grid.Column="0" Text="Activity Log" Foreground="#CCCCCC" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Content="Copy Log" Command="{Binding CopyLogsCommand}" Padding="8,2" Margin="0,0,6,0" FontSize="11" />
                                <Button Grid.Column="3" Content="Clear" Command="{Binding ClearLogsCommand}" Padding="8,2" FontSize="11" />
                            </Grid>
                            <ScrollViewer Grid.Row="1" x:Name="ActivityLogScrollViewer">
                                <ItemsControl ItemsSource="{Binding ActivityLogs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="services:LogMessageItem">
                                            <TextBlock Text="{Binding Message, StringFormat='[{0}] {1}'}" 
                                                       FontFamily="Consolas, monospace" FontSize="12" Margin="0,1"
                                                       Foreground="#DDDDDD" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 1: INTEGRATIONS VIEW -->
                <Grid Margin="16">
                    <TabControl>
                        <!-- Discord Webhooks Subtab -->
                        <TabItem Header="Discord Webhooks">
                            <Grid RowDefinitions="Auto,*" Margin="0,10,0,0">
                                <Grid Grid.Row="0" Margin="0,0,0,10" ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Post automated fight summaries &amp; tables to Discord channels." VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="+ Add Webhook" Command="{Binding AddWebhookCommand}" />
                                </Grid>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding DiscordWebhooksList}" AutoGenerateColumns="False" IsReadOnly="True"
                                          GridLinesVisibility="Horizontal">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding Active}" Width="60" />
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160" />
                                        <DataGridTextColumn Header="Webhook URL" Binding="{Binding Url}" Width="*" />
                                        <DataGridTextColumn Header="Summary Type" Binding="{Binding SummaryType}" Width="140" />
                                        <DataGridTemplateColumn Header="Actions" Width="180">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="discord:DiscordWebhookData">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <Button Content="Test" Command="{Binding $parent[Window].DataContext.TestWebhookCommand}" CommandParameter="{Binding}" Padding="6,2" FontSize="11" />
                                                        <Button Content="Edit" Command="{Binding $parent[Window].DataContext.EditWebhookCommand}" CommandParameter="{Binding}" Padding="6,2" FontSize="11" />
                                                        <Button Content="Delete" Command="{Binding $parent[Window].DataContext.DeleteWebhookCommand}" CommandParameter="{Binding}" Padding="6,2" FontSize="11" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <!-- Twitch Chatbot Subtab -->
                        <TabItem Header="Twitch Chat">
                            <ScrollViewer Margin="0,10,0,0">
                                <StackPanel Spacing="16" MaxWidth="700" HorizontalAlignment="Left">
                                    <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="8" Padding="16" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="Twitch Chat Integration" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="Automatically posts log links and boss kill messages into your Twitch stream chat." Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                            
                                            <Grid ColumnDefinitions="140,*,Auto" RowDefinitions="Auto,Auto" Margin="0,8,0,0">
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Twitch Channel:" VerticalAlignment="Center" Margin="0,0,10,10" />
                                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TwitchChannelName}" Watermark="e.g. your_twitch_username" Margin="0,0,10,10" />
                                                <Button Grid.Row="0" Grid.Column="2" Content="{Binding TwitchConnectButtonText}" Command="{Binding ToggleTwitchCommand}" Margin="0,0,0,10" />

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Options:" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Spacing="6">
                                                    <CheckBox Content="Post logs to Twitch chat" IsChecked="{Binding TwitchPostLogs}" />
                                                    <CheckBox Content="Post only if encounter was successful" IsChecked="{Binding TwitchOnlySuccess}" />
                                                    <CheckBox Content="Post only if streaming software is running (OBS Studio, Streamlabs, TwitchStudio)" IsChecked="{Binding TwitchOnlyStreamRunning}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Custom Bot Account -->
                                    <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="8" Padding="16" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1">
                                        <StackPanel Spacing="12">
                                            <CheckBox Content="Use Custom Twitch Bot Account (Default: gw2loguploader)" IsChecked="{Binding TwitchCustomBot}" FontWeight="SemiBold" />
                                            <StackPanel IsVisible="{Binding TwitchCustomBot}" Spacing="10" Margin="24,0,0,0">
                                                <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto">
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Bot Username:" VerticalAlignment="Center" Margin="0,0,0,8" />
                                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TwitchCustomBotName}" Watermark="bot_account_name" Margin="0,0,0,8" />
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="OAuth Token:" VerticalAlignment="Center" />
                                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TwitchCustomBotToken}" PasswordChar="*" Watermark="oauth:..." />
                                                </Grid>
                                            </StackPanel>
                                            <Button Content="Save Twitch Settings" Command="{Binding SaveTwitchSettingsCommand}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Twitch Commands -->
                                    <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="8" Padding="16" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1">
                                        <StackPanel Spacing="12">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="Chat Commands" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Content="Save Commands" Command="{Binding SaveTwitchCommandsCommand}" />
                                            </Grid>
                                            <TextBlock Text="Commands that the bot responds to in your Twitch channel chat." Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" FontSize="12" />
                                            <DataGrid ItemsSource="{Binding TwitchCommandsList}" AutoGenerateColumns="False" CanUserResizeColumns="True" MaxHeight="220">
                                                <DataGrid.Columns>
                                                    <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="70" />
                                                    <DataGridTextColumn Header="Trigger" Binding="{Binding Command}" Width="130" />
                                                    <DataGridTextColumn Header="Response" Binding="{Binding Response}" Width="*" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Aleeva Subtab -->
                        <TabItem Header="Aleeva">
                            <Grid RowDefinitions="Auto,Auto,*" Margin="0,10,0,0">
                                <Border Grid.Row="0" Margin="0,0,0,12" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="8" Padding="14" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1">
                                    <Grid ColumnDefinitions="140,*,Auto">
                                        <TextBlock Grid.Column="0" Text="Aleeva API Key:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0" />
                                        <TextBox Grid.Column="1" Text="{Binding AleevaApiKey}" PasswordChar="*" Watermark="Insert Aleeva API Key..." Margin="0,0,10,0" />
                                        <Button Grid.Column="2" Content="Verify Key" Command="{Binding VerifyAleevaApiKeyCommand}" />
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="1" Margin="0,0,0,10" ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Configured Aleeva Server &amp; Channel Integrations:" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="+ Add Integration" Command="{Binding AddAleevaCommand}" />
                                </Grid>
                                <DataGrid Grid.Row="2" ItemsSource="{Binding AleevaIntegrationsList}" AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding Active}" Width="60" />
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160" />
                                        <DataGridTextColumn Header="Server ID" Binding="{Binding Server}" Width="140" />
                                        <DataGridTextColumn Header="Channel ID" Binding="{Binding Channel}" Width="140" />
                                        <DataGridCheckBoxColumn Header="Send Notification" Binding="{Binding SendNotification}" Width="140" />
                                        <DataGridCheckBoxColumn Header="Success Only" Binding="{Binding SendOnSuccessOnly}" Width="110" />
                                        <DataGridTemplateColumn Header="Actions" Width="140">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="aleeva:AleevaIntegration">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <Button Content="Edit" Command="{Binding $parent[Window].DataContext.EditAleevaCommand}" CommandParameter="{Binding}" Padding="6,2" FontSize="11" />
                                                        <Button Content="Delete" Command="{Binding $parent[Window].DataContext.DeleteAleevaCommand}" CommandParameter="{Binding}" Padding="6,2" FontSize="11" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <!-- GW2Bot Subtab -->
                        <TabItem Header="GW2Bot">
                            <StackPanel Margin="0,10,0,0" Spacing="14" MaxWidth="600" HorizontalAlignment="Left">
                                <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="8" Padding="16" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1">
                                    <StackPanel Spacing="12">
                                        <CheckBox Content="Enable GW2Bot Integration" IsChecked="{Binding Gw2BotEnabled}" FontWeight="SemiBold" />
                                        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto" Margin="0,6,0,0">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="API Key:" VerticalAlignment="Center" Margin="0,0,0,10" />
                                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Gw2BotApiKey}" PasswordChar="*" Watermark="GW2Bot API Key..." Margin="0,0,0,10" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Filter:" VerticalAlignment="Center" />
                                            <CheckBox Grid.Row="1" Grid.Column="1" Content="Send only if encounter was successful" IsChecked="{Binding Gw2BotOnlySuccess}" />
                                        </Grid>
                                        <Button Content="Save GW2Bot Settings" Command="{Binding SaveGw2BotSettingsCommand}" HorizontalAlignment="Right" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </TabItem>

                        <!-- Remote Pings Subtab -->
                        <TabItem Header="Remote Pings">
                            <Grid RowDefinitions="Auto,*" Margin="0,10,0,0">
                                <Grid Grid.Row="0" Margin="0,0,0,10" ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Send HTTP webhooks to custom REST endpoints on combat finish." VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="+ Add Ping Endpoint" Command="{Binding AddPingCommand}" />
                                </Grid>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding RemotePingsList}" AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding Active}" Width="60" />
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160" />
                                        <DataGridTextColumn Header="Endpoint URL" Binding="{Binding Url}" Width="*" />
                                        <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="90" />
                                        <DataGridCheckBoxColumn Header="JSON" Binding="{Binding SendDataAsJson}" Width="70" />
                                        <DataGridTemplateColumn Header="Actions" Width="180">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="pings:PingConfiguration">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <Button Content="Test" Command="{Binding $parent[Window].DataContext.TestPingCommand}" CommandParameter="{Binding}" Padding="6,2" FontSize="11" />
                                                        <Button Content="Edit" Command="{Binding $parent[Window].DataContext.EditPingCommand}" CommandParameter="{Binding}" Padding="6,2" FontSize="11" />
                                                        <Button Content="Delete" Command="{Binding $parent[Window].DataContext.DeletePingCommand}" CommandParameter="{Binding}" Padding="6,2" FontSize="11" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <!-- dps.report & Wingman Subtab -->
                        <TabItem Header="dps.report &amp; Wingman">
                            <ScrollViewer Margin="0,10,0,0">
                                <StackPanel Spacing="16" MaxWidth="700" HorizontalAlignment="Left">
                                    <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="8" Padding="16" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="Upload Options" FontSize="15" FontWeight="SemiBold" />
                                            <CheckBox Content="Anonymous uploads (strips player account names)" IsChecked="{Binding AnonymousUpload}" />
                                            <CheckBox Content="Detailed WvW reports (includes full breakdown &amp; enemy targets)" IsChecked="{Binding DetailedWvW}" />
                                            <CheckBox Content="Auto-upload logs to Gw2Wingman" IsChecked="{Binding UploadToWingman}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="8" Padding="16" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1">
                                        <StackPanel Spacing="12">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="dps.report User Tokens" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Content="+ Add User Token" Command="{Binding AddUserTokenCommand}" />
                                            </Grid>
                                            <TextBlock Text="Add dps.report user tokens to upload logs directly under your personal or guild account." Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" FontSize="12" />
                                            <DataGrid ItemsSource="{Binding UserTokensList}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="220">
                                                <DataGrid.Columns>
                                                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding Active}" Width="60" />
                                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160" />
                                                    <DataGridTextColumn Header="Token" Binding="{Binding UserToken}" Width="*" />
                                                    <DataGridTemplateColumn Header="Actions" Width="140">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate DataType="gw2api:ApplicationSettingsUploadUserToken">
                                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                    <Button Content="Edit" Command="{Binding $parent[Window].DataContext.EditUserTokenCommand}" CommandParameter="{Binding}" Padding="6,2" FontSize="11" />
                                                                    <Button Content="Delete" Command="{Binding $parent[Window].DataContext.DeleteUserTokenCommand}" CommandParameter="{Binding}" Padding="6,2" FontSize="11" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>

                <!-- 2: LOG SESSION VIEW -->
                <Grid RowDefinitions="Auto,Auto,*" Margin="16">
                    <Border Grid.Row="0" Margin="0,0,0,12" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="8" Padding="16" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                <TextBlock Text="Raid / Strike / Fractal Log Session" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Group all logs from this play session into a single summary broadcast for Discord." Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Content="{Binding SessionButtonText}" Command="{Binding ToggleSessionCommand}" />
                                <Button Content="{Binding SessionPauseButtonText}" Command="{Binding TogglePauseSessionCommand}" IsEnabled="{Binding IsSessionRunning}" />
                            </StackPanel>
                            <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto,*" Margin="0,14,0,0">
                                <TextBlock Grid.Column="0" Text="Session Name:" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBox Grid.Column="1" Text="{Binding SessionName}" Watermark="e.g. Tuesday Night Raids" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="2" Text="Custom Message:" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBox Grid.Column="3" Text="{Binding SessionMessage}" Watermark="Optional Discord announcement message..." />
                            </Grid>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="1" Text="Logs Recorded in Current Session" FontWeight="SemiBold" Margin="4,0,0,8" />
                    <DataGrid Grid.Row="2" ItemsSource="{Binding RecentUploads}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimestampString}" Width="80" />
                            <DataGridTextColumn Header="Boss" Binding="{Binding BossName}" Width="*" />
                            <DataGridTextColumn Header="Mode" Binding="{Binding ModeBadge}" Width="80" />
                            <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="90" />
                            <DataGridTextColumn Header="Result" Binding="{Binding ResultBadge}" Width="90" />
                            <DataGridTextColumn Header="Permalink" Binding="{Binding Permalink}" Width="250" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- 3: ARCDPS PLUGINS VIEW -->
                <Grid RowDefinitions="Auto,*" Margin="16">
                    <Border Grid.Row="0" Margin="0,0,0,12" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="8" Padding="14" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <TextBlock Grid.Column="0" Text="Guild Wars 2 Directory:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1" Text="{Binding Gw2Location}" Watermark="e.g. C:\Program Files\Guild Wars 2 or Proton drive_c..." VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseGw2FolderCommand}" Margin="0,0,8,0" />
                            <Button Grid.Column="3" Content="Check Updates" Command="{Binding CheckArcUpdatesCommand}" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1">
                        <DataGrid ItemsSource="{Binding ArcDpsComponentsList}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Component" Binding="{Binding Type}" Width="200" />
                                <DataGridTextColumn Header="Relative Path" Binding="{Binding RelativeLocation}" Width="*" />
                                <DataGridTextColumn Header="GitHub Repo" Binding="{Binding Repository}" Width="250" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <!-- 4: TEAMS & GW2 API VIEW -->
                <Grid Margin="16">
                    <TabControl>
                        <TabItem Header="Teams (Player Filters)">
                            <Grid RowDefinitions="Auto,*" Margin="0,10,0,0">
                                <Grid Grid.Row="0" Margin="0,0,0,10" ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Define player teams to filter which webhooks and notifications fire." VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="+ Add Team" Command="{Binding AddTeamCommand}" />
                                </Grid>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding TeamsList}" AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" />
                                        <DataGridTextColumn Header="Team Name" Binding="{Binding Name}" Width="*" />
                                        <DataGridTextColumn Header="Condition Filter Mode" Binding="{Binding Limiter}" Width="160" />
                                        <DataGridTemplateColumn Header="Actions" Width="140">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="teams:Team">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <Button Content="Edit" Command="{Binding $parent[Window].DataContext.EditTeamCommand}" CommandParameter="{Binding}" Padding="6,2" FontSize="11" />
                                                        <Button Content="Delete" Command="{Binding $parent[Window].DataContext.DeleteTeamCommand}" CommandParameter="{Binding}" Padding="6,2" FontSize="11" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                        <TabItem Header="GW2 API Keys">
                            <Grid RowDefinitions="Auto,*" Margin="0,10,0,0">
                                <Grid Grid.Row="0" Margin="0,0,0,10" ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Guild Wars 2 API keys used for account name detection and Hardstuck build codes." VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="+ Add API Key" Command="{Binding AddGw2ApiKeyCommand}" />
                                </Grid>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding Gw2ApiKeysList}" AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Account / Name" Binding="{Binding Name}" Width="200" />
                                        <DataGridTextColumn Header="API Key" Binding="{Binding ApiKey}" Width="*" />
                                        <DataGridCheckBoxColumn Header="Valid" Binding="{Binding Valid}" Width="80" />
                                        <DataGridTemplateColumn Header="Actions" Width="140">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="gw2api:ApplicationSettingsGw2Api">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <Button Content="Edit" Command="{Binding $parent[Window].DataContext.EditGw2ApiKeyCommand}" CommandParameter="{Binding}" Padding="6,2" FontSize="11" />
                                                        <Button Content="Delete" Command="{Binding $parent[Window].DataContext.DeleteGw2ApiKeyCommand}" CommandParameter="{Binding}" Padding="6,2" FontSize="11" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>

                <!-- 5: SETTINGS VIEW -->
                <ScrollViewer Margin="16">
                    <StackPanel Spacing="16" MaxWidth="700" HorizontalAlignment="Left">
                        <!-- General / OS Settings -->
                        <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="8" Padding="16" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="System &amp; Startup" FontSize="16" FontWeight="SemiBold" />
                                <CheckBox Content="Launch automatically at system startup (Windows &amp; Linux supported)" IsChecked="{Binding StartupWithOs}" />
                                <CheckBox Content="Minimize to system tray instead of taskbar" IsChecked="{Binding MinimiseToTray}" />
                                <CheckBox Content="Close to system tray instead of exiting" IsChecked="{Binding CloseToTray}" />
                            </StackPanel>
                        </Border>

                        <!-- Log Monitoring Settings -->
                        <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="8" Padding="16" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Log Monitor &amp; Performance" FontSize="16" FontWeight="SemiBold" />
                                <CheckBox Content="Use Polling instead of FileSystemWatcher (useful for networked/Wine drives)" IsChecked="{Binding UsePolling}" />
                                <CheckBox Content="Save all uploads to uploaded_logs.csv in app folder" IsChecked="{Binding SaveToCsv}" />
                                <Grid ColumnDefinitions="200,*">
                                    <TextBlock Text="Max Concurrent Uploads:" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding MaxConcurrentUploads}" Minimum="1" Maximum="10" Increment="1" Width="120" HorizontalAlignment="Left" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Appearance Settings -->
                        <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="8" Padding="16" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Appearance &amp; Theme" FontSize="16" FontWeight="SemiBold" />
                                <Grid ColumnDefinitions="140,*">
                                    <TextBlock Text="App Theme:" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" SelectedItem="{Binding SelectedTheme}" Width="160">
                                        <x:String>System</x:String>
                                        <x:String>Dark</x:String>
                                        <x:String>Light</x:String>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Storage & Reset -->
                        <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="8" Padding="16" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Data &amp; Troubleshooting" FontSize="16" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Open Configuration Folder" Command="{Binding OpenConfigFolderCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Carousel>
        </Grid>
    </Grid>
</Window>
