<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PlenBotLogUploader.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:services="using:PlenBotLogUploader.Services"
        xmlns:discord="using:PlenBotLogUploader.DiscordApi"
        xmlns:teams="using:PlenBotLogUploader.Teams"
        xmlns:pings="using:PlenBotLogUploader.RemotePing"
        xmlns:arcdps="using:PlenBotLogUploader.ArcDps"
        xmlns:aleeva="using:PlenBotLogUploader.Aleeva"
        xmlns:gw2api="using:PlenBotLogUploader.AppSettings"
        xmlns:twitch="using:PlenBotLogUploader.Twitch"
        mc:Ignorable="d" d:DesignWidth="1120" d:DesignHeight="780"
        x:Class="PlenBotLogUploader.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Resources/Icon.ico"
        Title="PlenBot Log Uploader"
        Width="1120" Height="780"
        MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True">

    <Grid RowDefinitions="Auto,*">
        <!-- Top App Bar -->
        <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" 
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Brand Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border CornerRadius="6" ClipToBounds="True" Width="28" Height="28">
                        <Image Source="/Resources/Icon.ico" Width="28" Height="28" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="PlenBot Log Uploader" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Background="{DynamicResource BrandPrimary}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center" Margin="4,0,0,0">
                        <TextBlock Text="v105.0 • Cross-Platform" FontSize="11" Foreground="White" FontWeight="Bold" />
                    </Border>
                </StackPanel>

                <!-- Status Badges (Center) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Monitoring Badge -->
                    <Border CornerRadius="14" Padding="12,4" Background="{Binding MonitoringBadgeBackground}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="●" FontSize="10" Foreground="White" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding MonitoringStatusText}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <!-- Session Badge -->
                    <Border IsVisible="{Binding IsSessionRunning}" CornerRadius="14" Padding="12,4" Background="{DynamicResource BrandWarning}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="⏱" FontSize="11" Foreground="White" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SessionStatusText}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <!-- Twitch Badge -->
                    <Border IsVisible="{Binding IsTwitchConnected}" CornerRadius="14" Padding="12,4" Background="{DynamicResource BrandPurple}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="🟣" FontSize="10" VerticalAlignment="Center" />
                            <TextBlock Text="Twitch Connected" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Quick Actions (Right) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Command="{Binding ToggleMonitoringCommand}" Classes="accent" CornerRadius="8" Padding="14,6">
                        <TextBlock Text="{Binding MonitoringButtonText}" />
                    </Button>
                    <Button Command="{Binding ToggleSessionCommand}" CornerRadius="8" Padding="14,6">
                        <TextBlock Text="{Binding SessionButtonText}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body: Navigation Sidebar + Content Area -->
        <Grid Grid.Row="1" ColumnDefinitions="230,*">
            <!-- Sidebar Navigation -->
            <Border Grid.Column="0" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,1,0"
                    Padding="10,14">
                <Grid RowDefinitions="*,Auto">
                    <!-- Nav List -->
                    <ListBox Grid.Row="0" SelectedIndex="{Binding SelectedNavigationIndex}" SelectionMode="Single" Classes="sidebar">
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="4,4">
                                <TextBlock Text="📊" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="Dashboard" FontWeight="Medium" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="4,4">
                                <TextBlock Text="🌐" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="Integrations" FontWeight="Medium" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="4,4">
                                <TextBlock Text="⏱️" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="Log Session" FontWeight="Medium" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="4,4">
                                <TextBlock Text="🧩" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="arcDPS Plugins" FontWeight="Medium" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="4,4">
                                <TextBlock Text="👥" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="Teams &amp; GW2" FontWeight="Medium" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="4,4">
                                <TextBlock Text="⚙️" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="Settings" FontWeight="Medium" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>

                    <!-- Sidebar Footer -->
                    <StackPanel Grid.Row="1" Spacing="8" Margin="4,10,4,0">
                        <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />
                        <Button Command="{Binding OpenGitHubCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="compact" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <TextBlock Text="GitHub Repository" FontSize="11" />
                                <TextBlock Text="↗" FontSize="10" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="PlenBot Log Uploader v105.0" FontSize="10" 
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content Area (Switching by SelectedNavigationIndex) -->
            <Carousel Grid.Column="1" SelectedIndex="{Binding SelectedNavigationIndex}">
                <!-- 0: DASHBOARD VIEW -->
                <Grid RowDefinitions="Auto,Auto,*,210" Margin="16">
                    <!-- Logs Folder Path Banner & Warning -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,12" Spacing="8">
                        <Border Classes="card" CornerRadius="10" Padding="14,10">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="📁" FontSize="15" VerticalAlignment="Center" />
                                    <TextBlock Text="arcDPS Logs Folder:" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBox Grid.Column="1" Text="{Binding LogsLocation}" IsReadOnly="True" VerticalAlignment="Center" Margin="0,0,8,0" 
                                         Watermark="Select folder containing arcDPS .evtc / .zevtc combat logs..." />
                                <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseLogsFolderCommand}" Classes="accent" Margin="0,0,6,0" />
                                <Button Grid.Column="3" Content="Open Folder" Command="{Binding OpenLogsFolderCommand}" />
                            </Grid>
                        </Border>

                        <!-- Notice when no folder is selected -->
                        <Border IsVisible="{Binding HasNoLogsLocation}"
                                Background="#FFFBEB"
                                BorderBrush="{DynamicResource BrandWarning}" BorderThickness="1"
                                CornerRadius="8" Padding="12,10">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Column="0" Text="⚠️" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="No arcDPS combat logs folder configured" FontWeight="SemiBold" Foreground="#92400E" />
                                    <TextBlock Text="Select your logs folder so PlenBot can automatically monitor, parse, and upload fights." 
                                               FontSize="12" Foreground="#B45309" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="Configure Folder" Command="{Binding BrowseLogsFolderCommand}" Classes="accent" Padding="10,4" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Stat Cards & Drag & Drop Zone -->
                    <Grid Grid.Row="1" Margin="0,0,0,12" ColumnDefinitions="*,*,*,2*">
                        <!-- Stat: Total Logs -->
                        <Border Grid.Column="0" Margin="0,0,6,0" Classes="card" CornerRadius="10" Padding="12,10">
                            <StackPanel Spacing="3">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Total Scanned" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                    <TextBlock Grid.Column="1" Text="📁" FontSize="12" />
                                </Grid>
                                <TextBlock Text="{Binding LogsCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource BrandPrimary}" />
                                <TextBlock Text="Files in log folder" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Stat: Uploaded Logs -->
                        <Border Grid.Column="1" Margin="6,0,6,0" Classes="card" CornerRadius="10" Padding="12,10">
                            <StackPanel Spacing="3">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Session Uploads" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                    <TextBlock Grid.Column="1" Text="☁️" FontSize="12" />
                                </Grid>
                                <TextBlock Text="{Binding RecentUploads.Count}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource BrandSuccess}" />
                                <TextBlock Text="Processed this run" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Stat: Max Concurrency -->
                        <Border Grid.Column="2" Margin="6,0,6,0" Classes="card" CornerRadius="10" Padding="12,10">
                            <StackPanel Spacing="3">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Concurrent Limit" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                    <TextBlock Grid.Column="1" Text="⚡" FontSize="12" />
                                </Grid>
                                <TextBlock Text="{Binding MaxConcurrentUploads}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource BrandWarning}" />
                                <TextBlock Text="Parallel workers" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Drag and Drop Dropzone Card -->
                        <Border Grid.Column="3" Margin="6,0,0,0" BorderBrush="{DynamicResource BrandPrimary}" BorderThickness="1.5"
                                CornerRadius="10" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                Padding="10">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="📥 Drop .evtc / .zevtc Files Here" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" />
                                <TextBlock Text="Instant upload to dps.report" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Recent Uploads Card -->
                    <Border Grid.Row="2" Margin="0,0,0,12" Classes="card" CornerRadius="10" Padding="10">
                        <Grid RowDefinitions="Auto,*">
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="4,0,4,8">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="Recent Uploads" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RecentUploads.Count, StringFormat='{}{0} logs'}" FontSize="11" FontWeight="Medium" />
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Empty State when no uploads exist -->
                            <StackPanel Grid.Row="1" IsVisible="{Binding HasNoRecentUploads}" 
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" Margin="20">
                                <TextBlock Text="📋" FontSize="32" HorizontalAlignment="Center" />
                                <TextBlock Text="No combat encounters uploaded in this session yet" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" />
                                <TextBlock Text="Logs will appear here automatically when arcDPS finishes a fight, or drag &amp; drop files above." 
                                           FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- DataGrid when uploads exist -->
                            <DataGrid Grid.Row="1" IsVisible="{Binding HasRecentUploads}" 
                                      ItemsSource="{Binding RecentUploads}" AutoGenerateColumns="False" IsReadOnly="True"
                                      GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding TimestampString}" Width="80" />
                                    <DataGridTextColumn Header="Boss Encounter" Binding="{Binding BossName}" Width="*" />
                                    <DataGridTemplateColumn Header="Mode" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="services:LogUploadItem">
                                                <Border Background="{Binding ModeBackground}" CornerRadius="6" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ModeBadge}" Foreground="White" FontSize="11" FontWeight="Bold" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="80" />
                                    <DataGridTemplateColumn Header="Result" Width="95">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="services:LogUploadItem">
                                                <Border Background="{Binding ResultBackground}" CornerRadius="6" Padding="8,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ResultBadge}" Foreground="White" FontSize="11" FontWeight="Bold" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Actions" Width="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="services:LogUploadItem">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Button Content="Open" Click="OnOpenLogLinkClick" Tag="{Binding Permalink}" Classes="compact" />
                                                    <Button Content="Copy" Click="OnCopyLogLinkClick" Tag="{Binding Permalink}" Classes="compact" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Live Activity Log Console -->
                    <Border Grid.Row="3" Background="#16171D" BorderBrush="#2A2C38" BorderThickness="1" CornerRadius="10" Padding="12,10">
                        <Grid RowDefinitions="Auto,*">
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,8">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <Border Width="10" Height="10" CornerRadius="5" Background="#EF4444" />
                                        <Border Width="10" Height="10" CornerRadius="5" Background="#F59E0B" />
                                        <Border Width="10" Height="10" CornerRadius="5" Background="#10B981" />
                                    </StackPanel>
                                    <TextBlock Text="Activity Log Console" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="Copy Log" Command="{Binding CopyLogsCommand}" Classes="compact" Margin="0,0,6,0" />
                                <Button Grid.Column="3" Content="Clear" Command="{Binding ClearLogsCommand}" Classes="compact" />
                            </Grid>
                            <ScrollViewer Grid.Row="1" x:Name="ActivityLogScrollViewer">
                                <ItemsControl ItemsSource="{Binding ActivityLogs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="services:LogMessageItem">
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                                <TextBlock Text="{Binding TimestampString, StringFormat='[{0}]'}" 
                                                           FontFamily="Consolas, monospace" FontSize="11.5"
                                                           Foreground="#64748B" />
                                                <TextBlock Text="{Binding LevelBadge}" 
                                                           FontFamily="Consolas, monospace" FontSize="11.5"
                                                           Foreground="{Binding LevelColor}" />
                                                <TextBlock Text="{Binding Message}" 
                                                           FontFamily="Consolas, monospace" FontSize="11.5"
                                                           Foreground="#E2E8F0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 1: INTEGRATIONS VIEW -->
                <Grid Margin="16">
                    <TabControl Classes="modern-tabs">
                        <!-- Discord Webhooks Subtab -->
                        <TabItem Header="💬 Discord Webhooks">
                            <Grid RowDefinitions="Auto,*" Margin="0,12,0,0">
                                <Border Grid.Row="0" Classes="card" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="Automated Discord Postings" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="Automatically send encounter reports, player details, and combat summaries to Discord channels." 
                                                       FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="+ Add Webhook" Command="{Binding AddWebhookCommand}" Classes="accent" />
                                    </Grid>
                                </Border>

                                <!-- Empty State when no webhooks -->
                                <StackPanel Grid.Row="1" IsVisible="{Binding HasNoDiscordWebhooks}" 
                                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Margin="30">
                                    <TextBlock Text="💬" FontSize="36" HorizontalAlignment="Center" />
                                    <TextBlock Text="No Discord Webhooks Configured" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" />
                                    <TextBlock Text="Add a Discord webhook to broadcast fight summaries directly into your raid or guild channel." 
                                               FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" HorizontalAlignment="Center" />
                                    <Button Content="+ Add Your First Webhook" Command="{Binding AddWebhookCommand}" Classes="accent" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                </StackPanel>

                                <!-- Webhooks DataGrid -->
                                <Border Grid.Row="1" IsVisible="{Binding HasDiscordWebhooks}" Classes="card" CornerRadius="10" Padding="8">
                                    <DataGrid ItemsSource="{Binding DiscordWebhooksList}" AutoGenerateColumns="False" IsReadOnly="True"
                                              GridLinesVisibility="Horizontal">
                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding Active}" Width="65" />
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160" />
                                            <DataGridTextColumn Header="Webhook URL" Binding="{Binding Url}" Width="*" />
                                            <DataGridTextColumn Header="Summary Type" Binding="{Binding SummaryType}" Width="140" />
                                            <DataGridTemplateColumn Header="Actions" Width="190">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate DataType="discord:DiscordWebhookData">
                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <Button Content="Test" Command="{Binding $parent[Window].DataContext.TestWebhookCommand}" CommandParameter="{Binding}" Classes="compact" />
                                                            <Button Content="Edit" Command="{Binding $parent[Window].DataContext.EditWebhookCommand}" CommandParameter="{Binding}" Classes="compact" />
                                                            <Button Content="Delete" Command="{Binding $parent[Window].DataContext.DeleteWebhookCommand}" CommandParameter="{Binding}" Classes="compact danger" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- Twitch Chatbot Subtab -->
                        <TabItem Header="🟣 Twitch Chat">
                            <ScrollViewer Margin="0,12,0,0">
                                <StackPanel Spacing="14" MaxWidth="720" HorizontalAlignment="Left">
                                    <Border Classes="card" CornerRadius="10" Padding="16">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="Twitch Chat Stream Bot" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock Text="Automatically post log permalinks and boss victory messages into your Twitch stream chat." 
                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" FontSize="12" />
                                            
                                            <Grid ColumnDefinitions="140,*,Auto" RowDefinitions="Auto,Auto" Margin="0,6,0,0">
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Twitch Channel:" VerticalAlignment="Center" Margin="0,0,10,10" FontWeight="Medium" />
                                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TwitchChannelName}" Watermark="e.g. your_twitch_username" Margin="0,0,10,10" />
                                                <Button Grid.Row="0" Grid.Column="2" Content="{Binding TwitchConnectButtonText}" Command="{Binding ToggleTwitchCommand}" Classes="accent" Margin="0,0,0,10" />

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Options:" VerticalAlignment="Top" Margin="0,4,10,0" FontWeight="Medium" />
                                                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Spacing="6">
                                                    <CheckBox Content="Post logs to Twitch chat on combat end" IsChecked="{Binding TwitchPostLogs}" />
                                                    <CheckBox Content="Post only if encounter was successful" IsChecked="{Binding TwitchOnlySuccess}" />
                                                    <CheckBox Content="Post only if streaming software is running (OBS Studio, Streamlabs, TwitchStudio)" IsChecked="{Binding TwitchOnlyStreamRunning}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Custom Bot Account -->
                                    <Border Classes="card" CornerRadius="10" Padding="16">
                                        <StackPanel Spacing="12">
                                            <CheckBox Content="Use Custom Twitch Bot Account (Default: gw2loguploader)" IsChecked="{Binding TwitchCustomBot}" FontWeight="SemiBold" />
                                            <StackPanel IsVisible="{Binding TwitchCustomBot}" Spacing="10" Margin="24,0,0,0">
                                                <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto">
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Bot Username:" VerticalAlignment="Center" Margin="0,0,0,8" />
                                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TwitchCustomBotName}" Watermark="bot_account_name" Margin="0,0,0,8" />
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="OAuth Token:" VerticalAlignment="Center" />
                                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TwitchCustomBotToken}" PasswordChar="*" Watermark="oauth:..." />
                                                </Grid>
                                            </StackPanel>
                                            <Button Content="Save Twitch Settings" Command="{Binding SaveTwitchSettingsCommand}" Classes="accent" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Twitch Commands -->
                                    <Border Classes="card" CornerRadius="10" Padding="16">
                                        <StackPanel Spacing="12">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="Chat Commands" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Content="Save Commands" Command="{Binding SaveTwitchCommandsCommand}" />
                                            </Grid>
                                            <TextBlock Text="Commands that the bot responds to in your Twitch channel chat." Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" FontSize="12" />
                                            <DataGrid ItemsSource="{Binding TwitchCommandsList}" AutoGenerateColumns="False" CanUserResizeColumns="True" MaxHeight="220">
                                                <DataGrid.Columns>
                                                    <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="70" />
                                                    <DataGridTextColumn Header="Trigger" Binding="{Binding Command}" Width="130" />
                                                    <DataGridTextColumn Header="Response" Binding="{Binding Response}" Width="*" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Aleeva Subtab -->
                        <TabItem Header="🔷 Aleeva">
                            <Grid RowDefinitions="Auto,Auto,*" Margin="0,12,0,0">
                                <Border Grid.Row="0" Margin="0,0,0,12" Classes="card" CornerRadius="10" Padding="14">
                                    <Grid ColumnDefinitions="140,*,Auto">
                                        <TextBlock Grid.Column="0" Text="Aleeva API Key:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0" />
                                        <TextBox Grid.Column="1" Text="{Binding AleevaApiKey}" PasswordChar="*" Watermark="Insert Aleeva API Key..." Margin="0,0,10,0" />
                                        <Button Grid.Column="2" Content="Verify Key" Command="{Binding VerifyAleevaApiKeyCommand}" Classes="accent" />
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Margin="0,0,0,10" Classes="card" CornerRadius="10" Padding="14,10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Configured Aleeva Server &amp; Channel Integrations:" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="+ Add Integration" Command="{Binding AddAleevaCommand}" Classes="accent" />
                                    </Grid>
                                </Border>
                                <Border Grid.Row="2" Classes="card" CornerRadius="10" Padding="8">
                                    <DataGrid ItemsSource="{Binding AleevaIntegrationsList}" AutoGenerateColumns="False" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding Active}" Width="60" />
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160" />
                                            <DataGridTextColumn Header="Server ID" Binding="{Binding Server}" Width="140" />
                                            <DataGridTextColumn Header="Channel ID" Binding="{Binding Channel}" Width="140" />
                                            <DataGridCheckBoxColumn Header="Send Notification" Binding="{Binding SendNotification}" Width="140" />
                                            <DataGridCheckBoxColumn Header="Success Only" Binding="{Binding SendOnSuccessOnly}" Width="110" />
                                            <DataGridTemplateColumn Header="Actions" Width="150">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate DataType="aleeva:AleevaIntegration">
                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <Button Content="Edit" Command="{Binding $parent[Window].DataContext.EditAleevaCommand}" CommandParameter="{Binding}" Classes="compact" />
                                                            <Button Content="Delete" Command="{Binding $parent[Window].DataContext.DeleteAleevaCommand}" CommandParameter="{Binding}" Classes="compact danger" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- GW2Bot Subtab -->
                        <TabItem Header="🤖 GW2Bot">
                            <StackPanel Margin="0,12,0,0" Spacing="14" MaxWidth="620" HorizontalAlignment="Left">
                                <Border Classes="card" CornerRadius="10" Padding="16">
                                    <StackPanel Spacing="12">
                                        <CheckBox Content="Enable GW2Bot Integration" IsChecked="{Binding Gw2BotEnabled}" FontWeight="SemiBold" />
                                        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto" Margin="0,6,0,0">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="API Key:" VerticalAlignment="Center" Margin="0,0,0,10" FontWeight="Medium" />
                                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Gw2BotApiKey}" PasswordChar="*" Watermark="GW2Bot API Key..." Margin="0,0,0,10" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Filter:" VerticalAlignment="Center" FontWeight="Medium" />
                                            <CheckBox Grid.Row="1" Grid.Column="1" Content="Send only if encounter was successful" IsChecked="{Binding Gw2BotOnlySuccess}" />
                                        </Grid>
                                        <Button Content="Save GW2Bot Settings" Command="{Binding SaveGw2BotSettingsCommand}" Classes="accent" HorizontalAlignment="Right" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </TabItem>

                        <!-- Remote Pings Subtab -->
                        <TabItem Header="📡 Remote Pings">
                            <Grid RowDefinitions="Auto,*" Margin="0,12,0,0">
                                <Border Grid.Row="0" Margin="0,0,0,10" Classes="card" CornerRadius="10" Padding="14,10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="Custom HTTP REST Endpoints" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="Send HTTP webhook payloads to your own server or bot whenever combat finishes." 
                                                       FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="+ Add Ping Endpoint" Command="{Binding AddPingCommand}" Classes="accent" />
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Classes="card" CornerRadius="10" Padding="8">
                                    <DataGrid ItemsSource="{Binding RemotePingsList}" AutoGenerateColumns="False" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding Active}" Width="60" />
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160" />
                                            <DataGridTextColumn Header="Endpoint URL" Binding="{Binding Url}" Width="*" />
                                            <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="90" />
                                            <DataGridCheckBoxColumn Header="JSON" Binding="{Binding SendDataAsJson}" Width="70" />
                                            <DataGridTemplateColumn Header="Actions" Width="190">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate DataType="pings:PingConfiguration">
                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <Button Content="Test" Command="{Binding $parent[Window].DataContext.TestPingCommand}" CommandParameter="{Binding}" Classes="compact" />
                                                            <Button Content="Edit" Command="{Binding $parent[Window].DataContext.EditPingCommand}" CommandParameter="{Binding}" Classes="compact" />
                                                            <Button Content="Delete" Command="{Binding $parent[Window].DataContext.DeletePingCommand}" CommandParameter="{Binding}" Classes="compact danger" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- dps.report & Wingman Subtab -->
                        <TabItem Header="📊 dps.report &amp; Wingman">
                            <ScrollViewer Margin="0,12,0,0">
                                <StackPanel Spacing="14" MaxWidth="720" HorizontalAlignment="Left">
                                    <Border Classes="card" CornerRadius="10" Padding="16">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="Upload &amp; Parser Options" FontSize="15" FontWeight="SemiBold" />
                                            <CheckBox Content="Anonymous uploads (strips player account names)" IsChecked="{Binding AnonymousUpload}" />
                                            <CheckBox Content="Detailed WvW reports (includes full breakdown &amp; enemy targets)" IsChecked="{Binding DetailedWvW}" />
                                            <CheckBox Content="Auto-upload logs to Gw2Wingman" IsChecked="{Binding UploadToWingman}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Classes="card" CornerRadius="10" Padding="16">
                                        <StackPanel Spacing="12">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="dps.report User Tokens" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Content="+ Add User Token" Command="{Binding AddUserTokenCommand}" Classes="accent" />
                                            </Grid>
                                            <TextBlock Text="Add dps.report user tokens to upload logs directly under your personal or guild account." 
                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" FontSize="12" />
                                            <DataGrid ItemsSource="{Binding UserTokensList}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="220">
                                                <DataGrid.Columns>
                                                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding Active}" Width="60" />
                                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160" />
                                                    <DataGridTextColumn Header="Token" Binding="{Binding UserToken}" Width="*" />
                                                    <DataGridTemplateColumn Header="Actions" Width="150">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate DataType="gw2api:ApplicationSettingsUploadUserToken">
                                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                    <Button Content="Edit" Command="{Binding $parent[Window].DataContext.EditUserTokenCommand}" CommandParameter="{Binding}" Classes="compact" />
                                                                    <Button Content="Delete" Command="{Binding $parent[Window].DataContext.DeleteUserTokenCommand}" CommandParameter="{Binding}" Classes="compact danger" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>

                <!-- 2: LOG SESSION VIEW -->
                <Grid RowDefinitions="Auto,Auto,*" Margin="16">
                    <Border Grid.Row="0" Margin="0,0,0,12" Classes="card" CornerRadius="10" Padding="16">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="Raid / Strike / Fractal Log Session" FontSize="16" FontWeight="SemiBold" />
                                    <Border CornerRadius="12" Padding="8,2" Background="{DynamicResource BrandWarning}">
                                        <TextBlock Text="{Binding SessionStatusText}" Foreground="White" FontSize="11" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Group all logs from this play session into a single summary broadcast for Discord." 
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" FontSize="12" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Content="{Binding SessionButtonText}" Command="{Binding ToggleSessionCommand}" Classes="accent" />
                                <Button Content="{Binding SessionPauseButtonText}" Command="{Binding TogglePauseSessionCommand}" IsEnabled="{Binding IsSessionRunning}" />
                            </StackPanel>
                            <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto,*" Margin="0,14,0,0">
                                <TextBlock Grid.Column="0" Text="Session Name:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Medium" />
                                <TextBox Grid.Column="1" Text="{Binding SessionName}" Watermark="e.g. Tuesday Night Raids" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="2" Text="Custom Message:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Medium" />
                                <TextBox Grid.Column="3" Text="{Binding SessionMessage}" Watermark="Optional Discord announcement message..." />
                            </Grid>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="1" Text="Logs Recorded in Current Session" FontWeight="SemiBold" Margin="4,0,0,8" />
                    <Border Grid.Row="2" Classes="card" CornerRadius="10" Padding="8">
                        <DataGrid ItemsSource="{Binding RecentUploads}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding TimestampString}" Width="80" />
                                <DataGridTextColumn Header="Boss" Binding="{Binding BossName}" Width="*" />
                                <DataGridTemplateColumn Header="Mode" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="services:LogUploadItem">
                                            <Border Background="{Binding ModeBackground}" CornerRadius="6" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ModeBadge}" Foreground="White" FontSize="11" FontWeight="Bold" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="90" />
                                <DataGridTemplateColumn Header="Result" Width="95">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="services:LogUploadItem">
                                            <Border Background="{Binding ResultBackground}" CornerRadius="6" Padding="8,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ResultBadge}" Foreground="White" FontSize="11" FontWeight="Bold" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Permalink" Binding="{Binding Permalink}" Width="250" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <!-- 3: ARCDPS PLUGINS VIEW -->
                <Grid RowDefinitions="Auto,*" Margin="16">
                    <Border Grid.Row="0" Margin="0,0,0,12" Classes="card" CornerRadius="10" Padding="14">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="🎮" FontSize="15" VerticalAlignment="Center" />
                                <TextBlock Text="Guild Wars 2 Directory:" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBox Grid.Column="1" Text="{Binding Gw2Location}" Watermark="e.g. C:\Program Files\Guild Wars 2 or Proton drive_c..." VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseGw2FolderCommand}" Classes="accent" Margin="0,0,8,0" />
                            <Button Grid.Column="3" Content="Check Updates" Command="{Binding CheckArcUpdatesCommand}" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Classes="card" CornerRadius="10" Padding="8">
                        <DataGrid ItemsSource="{Binding ArcDpsComponentsList}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Component" Binding="{Binding Type}" Width="200" />
                                <DataGridTextColumn Header="Relative Path" Binding="{Binding RelativeLocation}" Width="*" />
                                <DataGridTextColumn Header="GitHub Repo" Binding="{Binding Repository}" Width="250" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <!-- 4: TEAMS & GW2 API VIEW -->
                <Grid Margin="16">
                    <TabControl Classes="modern-tabs">
                        <TabItem Header="👥 Teams (Player Filters)">
                            <Grid RowDefinitions="Auto,*" Margin="0,12,0,0">
                                <Border Grid.Row="0" Margin="0,0,0,10" Classes="card" CornerRadius="10" Padding="14,10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="Static Squads &amp; Player Filters" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="Define player teams to filter which webhooks and notifications fire based on squad composition." 
                                                       FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="+ Add Team" Command="{Binding AddTeamCommand}" Classes="accent" />
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Classes="card" CornerRadius="10" Padding="8">
                                    <DataGrid ItemsSource="{Binding TeamsList}" AutoGenerateColumns="False" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" />
                                            <DataGridTextColumn Header="Team Name" Binding="{Binding Name}" Width="*" />
                                            <DataGridTextColumn Header="Condition Filter Mode" Binding="{Binding Limiter}" Width="160" />
                                            <DataGridTemplateColumn Header="Actions" Width="150">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate DataType="teams:Team">
                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <Button Content="Edit" Command="{Binding $parent[Window].DataContext.EditTeamCommand}" CommandParameter="{Binding}" Classes="compact" />
                                                            <Button Content="Delete" Command="{Binding $parent[Window].DataContext.DeleteTeamCommand}" CommandParameter="{Binding}" Classes="compact danger" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </Grid>
                        </TabItem>
                        <TabItem Header="🔑 GW2 API Keys">
                            <Grid RowDefinitions="Auto,*" Margin="0,12,0,0">
                                <Border Grid.Row="0" Margin="0,0,0,10" Classes="card" CornerRadius="10" Padding="14,10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="Guild Wars 2 Account API Keys" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="Guild Wars 2 API keys used for automatic account identification and Hardstuck build codes." 
                                                       FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="+ Add API Key" Command="{Binding AddGw2ApiKeyCommand}" Classes="accent" />
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Classes="card" CornerRadius="10" Padding="8">
                                    <DataGrid ItemsSource="{Binding Gw2ApiKeysList}" AutoGenerateColumns="False" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Account / Name" Binding="{Binding Name}" Width="200" />
                                            <DataGridTextColumn Header="API Key" Binding="{Binding ApiKey}" Width="*" />
                                            <DataGridCheckBoxColumn Header="Valid" Binding="{Binding Valid}" Width="80" />
                                            <DataGridTemplateColumn Header="Actions" Width="150">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate DataType="gw2api:ApplicationSettingsGw2Api">
                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <Button Content="Edit" Command="{Binding $parent[Window].DataContext.EditGw2ApiKeyCommand}" CommandParameter="{Binding}" Classes="compact" />
                                                            <Button Content="Delete" Command="{Binding $parent[Window].DataContext.DeleteGw2ApiKeyCommand}" CommandParameter="{Binding}" Classes="compact danger" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>

                <!-- 5: SETTINGS VIEW -->
                <ScrollViewer Margin="16">
                    <StackPanel Spacing="14" MaxWidth="720" HorizontalAlignment="Left">
                        <!-- General / OS Settings -->
                        <Border Classes="card" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="🖥️" FontSize="16" />
                                    <TextBlock Text="System &amp; Startup" FontSize="16" FontWeight="SemiBold" />
                                </StackPanel>
                                <CheckBox Content="Launch automatically at system startup (Windows &amp; Linux supported)" IsChecked="{Binding StartupWithOs}" />
                                <CheckBox Content="Minimize to system tray instead of taskbar" IsChecked="{Binding MinimiseToTray}" />
                                <CheckBox Content="Close to system tray instead of exiting" IsChecked="{Binding CloseToTray}" />
                            </StackPanel>
                        </Border>

                        <!-- Log Monitoring Settings -->
                        <Border Classes="card" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="⚡" FontSize="16" />
                                    <TextBlock Text="Log Monitor &amp; Performance" FontSize="16" FontWeight="SemiBold" />
                                </StackPanel>
                                <CheckBox Content="Use Polling instead of FileSystemWatcher (useful for networked / Wine drives)" IsChecked="{Binding UsePolling}" />
                                <CheckBox Content="Save all uploads to uploaded_logs.csv in application folder" IsChecked="{Binding SaveToCsv}" />
                                <Grid ColumnDefinitions="200,*">
                                    <TextBlock Text="Max Concurrent Uploads:" VerticalAlignment="Center" FontWeight="Medium" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding MaxConcurrentUploads}" Minimum="1" Maximum="10" Increment="1" Width="120" HorizontalAlignment="Left" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Appearance Settings -->
                        <Border Classes="card" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="🎨" FontSize="16" />
                                    <TextBlock Text="Appearance &amp; Theme" FontSize="16" FontWeight="SemiBold" />
                                </StackPanel>
                                <Grid ColumnDefinitions="140,*">
                                    <TextBlock Text="App Theme:" VerticalAlignment="Center" FontWeight="Medium" />
                                    <ComboBox Grid.Column="1" SelectedItem="{Binding SelectedTheme}" Width="160">
                                        <x:String>System</x:String>
                                        <x:String>Dark</x:String>
                                        <x:String>Light</x:String>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Storage & Troubleshooting -->
                        <Border Classes="card" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="🛠️" FontSize="16" />
                                    <TextBlock Text="Data &amp; Troubleshooting" FontSize="16" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Open Configuration Folder" Command="{Binding OpenConfigFolderCommand}" Classes="accent" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Carousel>
        </Grid>
    </Grid>
</Window>