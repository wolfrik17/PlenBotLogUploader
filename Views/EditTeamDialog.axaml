<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:teams="using:PlenBotLogUploader.Teams"
        mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="420"
        x:Class="PlenBotLogUploader.Views.EditTeamDialog"
        Icon="/Resources/Icon.ico"
        Title="Edit Team"
        Width="460" Height="420"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*,Auto" Margin="20">
        <StackPanel Grid.Row="0" Spacing="14">
            <TextBlock Text="Team Details" FontSize="16" FontWeight="SemiBold" />

            <StackPanel Spacing="4">
                <TextBlock Text="Team Name:" FontWeight="Medium" />
                <TextBox x:Name="TextBoxName" Watermark="e.g. Static Raid Group" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Limiter Filter Mode:" FontWeight="Medium" />
                <ComboBox x:Name="ComboBoxLimiter" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Any (at least one player must match condition)" />
                    <ComboBoxItem Content="All (all players in condition must be in log)" />
                    <ComboBoxItem Content="Except (none of the players in condition may be in log)" />
                </ComboBox>
            </StackPanel>

            <TextBlock Text="Conditions: player accounts and characters can be filtered in this team."
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,14,0,0">
            <Button Grid.Column="1" Content="Save" Classes="accent" Click="OnSaveClick" Margin="0,0,8,0" Width="80" />
            <Button Grid.Column="2" Content="Cancel" Click="OnCancelClick" Width="80" />
        </Grid>
    </Grid>
</Window>
