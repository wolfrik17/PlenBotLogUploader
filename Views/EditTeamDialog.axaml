<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:teams="using:PlenBotLogUploader.Teams"
        mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="430"
        x:Class="PlenBotLogUploader.Views.EditTeamDialog"
        Icon="/Resources/Icon.ico"
        Title="Edit Team"
        Width="480" Height="430"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*,Auto" Margin="18">
        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,14" Classes="card" CornerRadius="8" Padding="12,10">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="👥" FontSize="20" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Team Details &amp; Filters" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="Configure squad members and filter criteria for webhooks." 
                               FontSize="11.5" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Form Card -->
        <Border Grid.Row="1" Classes="card" CornerRadius="8" Padding="14">
            <StackPanel Spacing="14">
                <StackPanel Spacing="4">
                    <TextBlock Text="Team Name:" FontWeight="Medium" FontSize="12" />
                    <TextBox x:Name="TextBoxName" Watermark="e.g. Static Raid Group / Tuesday Squad" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Limiter Filter Mode:" FontWeight="Medium" FontSize="12" />
                    <ComboBox x:Name="ComboBoxLimiter" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Any (at least one member in squad)" />
                        <ComboBoxItem Content="All (all configured members must be in squad)" />
                        <ComboBoxItem Content="Except (none of the configured members in squad)" />
                    </ComboBox>
                </StackPanel>

                <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" CornerRadius="6" Padding="10">
                    <TextBlock Text="💡 Filter modes determine whether a log matches this team when evaluating webhook notification rules."
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" FontSize="11.5" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Bottom Buttons -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,14,0,0">
            <Button Grid.Column="1" Content="Save" Classes="accent" Click="OnSaveClick" Margin="0,0,8,0" Width="90" CornerRadius="6" />
            <Button Grid.Column="2" Content="Cancel" Click="OnCancelClick" Width="90" CornerRadius="6" />
        </Grid>
    </Grid>
</Window>