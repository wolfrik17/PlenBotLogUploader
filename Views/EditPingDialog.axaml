<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:pings="using:PlenBotLogUploader.RemotePing"
        mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="460"
        x:Class="PlenBotLogUploader.Views.EditPingDialog"
        Icon="/Resources/Icon.ico"
        Title="Edit Remote Ping Endpoint"
        Width="480" Height="460"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*,Auto" Margin="20">
        <StackPanel Grid.Row="0" Spacing="14">
            <TextBlock Text="Remote Ping Configuration" FontSize="16" FontWeight="SemiBold" />

            <StackPanel Spacing="4">
                <TextBlock Text="Endpoint Name:" FontWeight="Medium" />
                <TextBox x:Name="TextBoxName" Watermark="e.g. Guild Raid Logger API" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="URL:" FontWeight="Medium" />
                <TextBox x:Name="TextBoxUrl" Watermark="https://myguild.com/api/logs" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="HTTP Method:" FontWeight="Medium" />
                <ComboBox x:Name="ComboBoxMethod" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="POST" />
                    <ComboBoxItem Content="PUT" />
                    <ComboBoxItem Content="GET" />
                    <ComboBoxItem Content="DELETE" />
                </ComboBox>
            </StackPanel>

            <CheckBox x:Name="CheckBoxActive" Content="Active (ping this server on log finish)" IsChecked="True" />
            <CheckBox x:Name="CheckBoxSendJson" Content="Send data as JSON payload" IsChecked="True" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,14,0,0">
            <Button Grid.Column="1" Content="Save" Classes="accent" Click="OnSaveClick" Margin="0,0,8,0" Width="80" />
            <Button Grid.Column="2" Content="Cancel" Click="OnCancelClick" Width="80" />
        </Grid>
    </Grid>
</Window>
