<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:aleeva="using:PlenBotLogUploader.Aleeva"
        mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="480"
        x:Class="PlenBotLogUploader.Views.EditAleevaDialog"
        Icon="/Resources/Icon.ico"
        Title="Edit Aleeva Integration"
        Width="480" Height="480"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*,Auto" Margin="18">
        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,14" Classes="card" CornerRadius="8" Padding="12,10">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="🔷" FontSize="20" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Aleeva Server &amp; Channel" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="Broadcast combat logs to Aleeva-managed Discord channels." 
                               FontSize="11.5" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Form Card -->
        <Border Grid.Row="1" Classes="card" CornerRadius="8" Padding="14">
            <StackPanel Spacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Text="Integration Name:" FontWeight="Medium" FontSize="12" />
                    <TextBox x:Name="TextBoxName" Watermark="e.g. Guild Raid Channel" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Discord Server ID:" FontWeight="Medium" FontSize="12" />
                    <TextBox x:Name="TextBoxServer" Watermark="Discord Server (Guild) ID" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Discord Channel ID:" FontWeight="Medium" FontSize="12" />
                    <TextBox x:Name="TextBoxChannel" Watermark="Discord Channel ID" />
                </StackPanel>

                <StackPanel Spacing="8" Margin="0,4,0,0">
                    <CheckBox x:Name="CheckBoxActive" Content="Active (enable posting)" IsChecked="True" FontWeight="Medium" />
                    <CheckBox x:Name="CheckBoxNotification" Content="Send notification message to channel" IsChecked="True" />
                    <CheckBox x:Name="CheckBoxSuccessOnly" Content="Send only if fight was successful" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Bottom Buttons -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,14,0,0">
            <Button Grid.Column="1" Content="Save" Classes="accent" Click="OnSaveClick" Margin="0,0,8,0" Width="90" CornerRadius="6" />
            <Button Grid.Column="2" Content="Cancel" Click="OnCancelClick" Width="90" CornerRadius="6" />
        </Grid>
    </Grid>
</Window>