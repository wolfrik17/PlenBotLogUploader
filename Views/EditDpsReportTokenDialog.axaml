<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PlenBotLogUploader.Views.EditDpsReportTokenDialog"
        Title="Edit dps.report User Token"
        Width="480" Height="280"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <Grid RowDefinitions="*,Auto" Margin="18">
        <StackPanel Grid.Row="0" Spacing="14">
            <TextBlock Text="dps.report User Token" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="User tokens associate uploads with your dps.report account for tracking logs across devices." 
                       TextWrapping="Wrap" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" FontSize="12" />

            <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name / Label:" VerticalAlignment="Center" Margin="0,0,0,10" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TextBoxName" Watermark="e.g. My Account / Main" Margin="0,0,0,10" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="User Token:" VerticalAlignment="Center" Margin="0,0,0,10" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TextBoxToken" Watermark="dps.report user token..." PasswordChar="*" Margin="0,0,0,10" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Active:" VerticalAlignment="Center" />
                <CheckBox Grid.Row="2" Grid.Column="1" x:Name="CheckBoxActive" Content="Use this token for uploads" IsChecked="True" />
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,16,0,0">
            <Button Content="Cancel" Click="OnCancelClick" Width="80" HorizontalContentAlignment="Center" />
            <Button Content="Save" Click="OnSaveClick" Width="80" Classes="accent" HorizontalContentAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
